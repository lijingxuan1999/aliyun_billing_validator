# ── Billing Validator MCP Server — local .env example ──────────────────────────
# Copy to .env and fill real values for local dev.
# BTP CF deployments do NOT need this — VCAP_SERVICES is auto-injected.
#
# How to get values:
#   cf env billing-validator-srv   → VCAP_SERVICES.xsuaa[0].credentials
#   cf service-key Coach_mini_Poc_aicore <key>

# ── billing-validator-srv (target OData) ──────────────────────────────────────
SRV_URL=https://billing-validator-coach.cfapps.eu12.hana.ondemand.com

# ── XSUAA (Coach_mini_Poc_xsuaa) ──────────────────────────────────────────────
XSUAA_URL=https://<your-tenant>.authentication.eu12.hana.ondemand.com
XSUAA_CLIENT_ID=sb-billing-validator!t<tenant-id>
XSUAA_CLIENT_SECRET=<copy-from-credentials.clientsecret>

# ── SAP AI Core ────────────────────────────────────────────────────────────────
AICORE_DEPLOYMENT_ID=d60e80b92fb0e1c3
AICORE_RESOURCE_GROUP=default
MODEL_ID=anthropic--claude-4.6-sonnet

AICORE_AUTH_URL=https://<aicore-uaa>.authentication.eu12.hana.ondemand.com
AICORE_CLIENT_ID=<sb-...>
AICORE_CLIENT_SECRET=<...>
AICORE_BASE_URL=https://api.ai.prod.eu-central-1.aws.ml.hana.ondemand.com/v2

# ── MCP API Key (protects the public MCP endpoint) ────────────────────────────
# Generate a strong random string, e.g.: openssl rand -hex 32
MCP_API_KEY=replace-with-a-strong-random-secret

# ── Runtime ────────────────────────────────────────────────────────────────────
USE_MOCK_DATA=false
ODATA_PAGE_TOP=20
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO
